# ---- Server ----
PORT=5000
NODE_ENV=development

# Comma separated list of browser origins allowed to call the API with credentials
CLIENT_URL=http://localhost:3000

# ---- MongoDB ----
# Omit or leave unreachable to fall back to an in-memory MongoDB for local testing
MONGO_URI=mongodb://mongodb:27017/lm-verify

# ---- Auth ----
# REQUIRED in production. Generate with: openssl rand -base64 48
JWT_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret-must-differ
JWT_EXPIRY=15m
REFRESH_EXPIRY=7d
REFRESH_EXPIRY_MS=604800000
BCRYPT_ROUNDS=12

# Send the refresh cookie only over HTTPS (forced on when NODE_ENV=production)
COOKIE_SECURE=false

# Account lockout after repeated failed sign-ins
MAX_LOGIN_ATTEMPTS=5
LOCK_WINDOW_MS=900000

# ---- Redis ----
REDIS_URL=redis://redis:6379

# ---- Vision service (OCR + measurement sidecar) ----
OCR_SERVICE_URL=http://vision:8001
VISION_TIMEOUT_MS=30000

# Which OCR engine the sidecar loads: paddleocr | easyocr
# With neither installed it falls back to a deterministic stub and flags every
# reading for officer review.
OCR_ENGINE=paddleocr

# Optional VLM pass over the two unstructured declaration heads (manufacturer
# block, generic name). Leave off and those heads route to officer review.
VLM_ENABLED=false
ANTHROPIC_API_KEY=

# ---- Upload ----
UPLOAD_MAX_SIZE=20MB
